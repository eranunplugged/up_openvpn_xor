#!/bin/bash

#
# Generate one or more client certificates with EasyRSA
#
# Usage: ovpn_genclientcert <clientname> <password|nopass> <count>
# Builds <clientname>1 .. <clientname><count>.
#

if [ "${DEBUG:-0}" == "1" ]; then
  set -x
fi

set -euo pipefail

CLIENTNAME="${1:?usage: ovpn_genclientcert <clientname> <password|nopass> <count>}"
PASSWORD="${2:?password (or 'nopass') required}"
NUM_USER="${3:?client count required}"
case "$NUM_USER" in (*[!0-9]*|'') echo "count must be a positive integer" >&2; exit 1;; esac

source "$OPENVPN/ovpn_env.sh"

# EasyRSA is baked into the image (UNP-8203) — no runtime download.
EASYRSA_DIR="${EASYRSA_DIR:-/opt/easyrsa}"
export EASYRSA="$EASYRSA_DIR"
export EASYRSA_SSL_CONF="$EASYRSA_DIR/openssl-easyrsa.cnf"
# Only honor EASYRSA_VARS_FILE if it exists (EasyRSA 3.2 errors otherwise)
[ -n "${EASYRSA_VARS_FILE:-}" ] && [ ! -f "$EASYRSA_VARS_FILE" ] && unset EASYRSA_VARS_FILE

for i in $(seq 1 "$NUM_USER"); do
    "$EASYRSA_DIR/easyrsa" build-client-full "${CLIENTNAME}${i}" "$PASSWORD"
done
