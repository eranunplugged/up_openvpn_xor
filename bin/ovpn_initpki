#!/bin/bash

#
# Initialize the EasyRSA PKI
#

if [ "${DEBUG:-0}" == "1" ]; then
  set -x
fi

set -euo pipefail

source "$OPENVPN/ovpn_env.sh"

# Specify "nopass" as arg[2] to make the CA insecure (not recommended!)
nopass="${1:-}"

# EasyRSA is baked into the image (UNP-8203) — no runtime download.
EASYRSA_DIR="${EASYRSA_DIR:-/opt/easyrsa}"
export EASYRSA="$EASYRSA_DIR"
export EASYRSA_SSL_CONF="$EASYRSA_DIR/openssl-easyrsa.cnf"
# EasyRSA 3.2 prompts on build-ca/build-server-full unless batch mode is set.
# init-vpn.sh passes EASYRSA_BATCH for this step, but set it here too so the
# script is non-interactive regardless of caller. (UNP-8203)
export EASYRSA_BATCH=1
# EASYRSA_VARS_FILE is an optional drop-in (persisted in the /etc/openvpn volume).
# EasyRSA 3.2 hard-errors if it's set but missing, so only honor it when present.
[ -n "${EASYRSA_VARS_FILE:-}" ] && [ ! -f "$EASYRSA_VARS_FILE" ] && unset EASYRSA_VARS_FILE
easyrsa="$EASYRSA_DIR/easyrsa"

# Provides a sufficient warning before erasing pre-existing files
"$easyrsa" init-pki

# CA always has a password for protection in event server is compromised. The
# password is only needed to sign client/server certificates.  No password is
# needed for normal OpenVPN operation.
"$easyrsa" build-ca ${nopass}

"$easyrsa" gen-dh
# OpenVPN 2.6 renamed `--genkey --secret <f>` to `--genkey secret <f>` (UNP-8203)
openvpn --genkey secret "$EASYRSA_PKI/ta.key"

# For a server key with a password, manually init; this is autopilot
"$easyrsa" build-server-full "$OVPN_CN" nopass

# Generate the CRL for client/server certificates revocation.
"$easyrsa" gen-crl
